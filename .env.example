# Modèle de configuration : copier ce fichier en ".env" puis renseigner les valeurs.
# Le fichier ".env" ne doit jamais être envoyé sur GitHub (il est exclu par .gitignore).

# API France Travail (créer une application sur francetravail.io)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# MinIO (Data Lake)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# PostgreSQL (base structurée)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
